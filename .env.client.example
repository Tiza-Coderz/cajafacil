# Build para un cliente real (sin modo demo). Copie a .env.client y compile:
#   flutter build apk --release --dart-define-from-file=.env.client
# En CI no hace falta este archivo: lo arma .github/workflows/build-client.yml
# con los secrets del Environment del cliente. NUNCA suba .env.client.

DEMO_MODE=false

# Supabase del cliente: Dashboard > Project Settings > API
#   "Project URL" y la clave "anon public" (es pública; la protege RLS).
SYNC_ENABLED=true
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=su-anon-key-publica

# WhatsApp de soporte que verá el cliente (internacional, sin +)
SUPPORT_WHATSAPP=5350000000
