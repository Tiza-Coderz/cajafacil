# Copie este archivo a .env y ejecute:
#   flutter run --dart-define-from-file=.env
# NUNCA suba el archivo .env al repositorio.

# Modo demo: siembra datos de ejemplo y muestra credenciales en el login
DEMO_MODE=true

# Sincronización opcional con Supabase (la app funciona 100% offline sin esto)
SYNC_ENABLED=false
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=su-anon-key-publica

# Número de WhatsApp de soporte (formato internacional sin +)
SUPPORT_WHATSAPP=5350000000
