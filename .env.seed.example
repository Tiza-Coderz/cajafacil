# Datos para cargar el negocio de prueba en Supabase. Copie a .env.seed y:
#   dart run tool/seed_supabase.dart
# Solo lo usa el script (no entra en la app). NUNCA suba .env.seed.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=su-anon-key-publica

# Cuenta del dueño creada en Supabase > Authentication > Users
# (con "Auto Confirm User" marcado). Es la misma que se usa en la app
# para "Vincular con la nube".
OWNER_EMAIL=dueno@ejemplo.cu
OWNER_PASSWORD=su-contrasena
